<?xml version="1.0" encoding="utf-8" ?>
<extension type="component" version="3.5" method="upgrade">
	<name>COM_SSO</name>
	<creationDate>16 september 2026</creationDate>
	<author>RolandD Cyber Produksi</author>
	<authorEmail>contact@rolandd.com</authorEmail>
	<authorUrl>https://rolandd.com</authorUrl>
	<copyright>Copyright (C) 2017 - 2026 RolandD Cyber Produksi. All rights reserved.</copyright>
	<license>GNU/GPLv3 https://www.gnu.org/licenses/gpl-3.0.html</license>
	<version>2.3.1</version>
	<description>COM_SSO_XML_DESCRIPTION</description>
	<namespace path="src">Rolandd\Component\Sso</namespace>

	<!-- Scripts to run on installation -->
	<scriptfile>script.php</scriptfile>

	<!-- Front-end files -->
	<files folder="components/com_sso">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<!-- Media files -->
	<media folder="media/com_sso" destination="com_sso">
		<file>joomla.asset.json</file>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<!-- Back-end files -->
	<administration>
		<!-- Menu entries -->
		<menu view="sso">COM_SSO</menu>
		<submenu>
			<menu link="option=com_sso&amp;view=sso">COM_SSO_DASHBOARD</menu>
			<menu link="option=com_sso&amp;view=config">COM_SSO_CONFIGURATION</menu>
			<menu link="option=com_sso&amp;view=profiles">COM_SSO_PROFILES</menu>
			<menu link="option=com_sso&amp;view=clients">COM_SSO_CLIENTS</menu>
			<menu link="option=com_sso&amp;view=certificates">COM_SSO_CERTIFICATES</menu>
			<menu link="option=com_sso&amp;view=excludes">COM_SSO_EXCLUDES</menu>
		</submenu>

		<!-- Core files -->
		<files folder="administrator/components/com_sso">
			<filename>access.xml</filename>
			<filename>changelog.txt</filename>
			<filename>config.xml</filename>
			<filename>LICENSE.txt</filename>
			<folder>assets</folder>
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>

	<updateservers>
		<server type="extension" priority="1" name="RO Single Sign On">https://rolandd.com/updates/rosso</server>
	</updateservers>
</extension>
