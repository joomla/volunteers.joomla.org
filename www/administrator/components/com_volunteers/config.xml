<?xml version="1.0" encoding="utf-8"?>
<config>
	<inlinehelp button="show"/>
	<fieldset
		name="board"
		label="COM_VOLUNTEERS_CONFIG_BOARD_LABEL"
		description="COM_VOLUNTEERS_CONFIG_BOARD_DESC"
		addfieldprefix="Joomla\Component\Volunteers\Administrator\Field"
		>
		<field
			name="board_department"
			type="departments"
			label="COM_VOLUNTEERS_CONFIG_BOARD_DEPARTMENT_LABEL"
			description="COM_VOLUNTEERS_CONFIG_BOARD_DEPARTMENT_DESC"
			filter="integer"
			default="0"
		/>
		<field
			name="board_positions"
			type="positions"
			label="COM_VOLUNTEERS_CONFIG_BOARD_POSITIONS_LABEL"
			description="COM_VOLUNTEERS_CONFIG_BOARD_POSITIONS_DESC"
			layout="joomla.form.field.groupedlist-fancy-select"
			multiple="true"
			filter="intarray"
		/>
	</fieldset>
	<fieldset name="permissions" description="JCONFIG_PERMISSIONS_DESC" label="JCONFIG_PERMISSIONS_LABEL">
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			component="com_volunteers"
			class="inputbox"
			filter="rules"
			validate="rules"
			section="component"
		/>
	</fieldset>

	<fieldset name="component">
		<field
			name="save_history"
			type="radio"
			label="JGLOBAL_SAVE_HISTORY_OPTIONS_LABEL"
			description="JGLOBAL_SAVE_HISTORY_OPTIONS_DESC"
			layout="joomla.form.field.radio.switcher"
			default="0"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="history_limit"
			type="text"
			label="JGLOBAL_HISTORY_LIMIT_OPTIONS_LABEL"
			description="JGLOBAL_HISTORY_LIMIT_OPTIONS_DESC"
			filter="integer"
			default="5"
		/>
		<field
			name="sef_ids"
			type="radio"
			label="JGLOBAL_SEF_NOIDS_LABEL"
			description="JGLOBAL_SEF_NOIDS_DESC"
			layout="joomla.form.field.radio.switcher"
			filter="integer"
			default="0"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>
</config>
