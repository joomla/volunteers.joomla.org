<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_VOLUNTEERS_FILTER_SEARCH"
			description="COM_VOLUNTEERS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="published"
			type="status"
			label="COM_VOLUNTEERS_FILTER_PUBLISHED"
			description="COM_VOLUNTEERS_FILTER_PUBLISHED_DESC"
			class="js-select-submit-on-change"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field
			name="type"
			type="list"
			label="COM_VOLUNTEERS_FIELD_TYPE"
			class="js-select-submit-on-change"
			>
			<option value="">COM_VOLUNTEERS_SELECT_TYPE</option>
			<option value="1">COM_VOLUNTEERS_FIELD_DEPARTMENT</option>
			<option value="2">COM_VOLUNTEERS_FIELD_TEAM</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="hidden"
		/>

		<field
			name="limit"
			type="limitbox"
			label="COM_VOLUNTEERS_LIST_LIMIT"
			description="COM_VOLUNTEERS_LIST_LIMIT_DESC"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
