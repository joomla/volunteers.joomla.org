<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter" addfieldprefix="Joomla\Component\Volunteers\Administrator\Field">
		<field
			name="search"
			type="text"
			label="COM_VOLUNTEERS_FILTER_SEARCH"
			description="COM_VOLUNTEERS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="published"
			type="status"
			label="COM_VOLUNTEERS_FILTER_PUBLISHED"
			description="COM_VOLUNTEERS_FILTER_PUBLISHED_DESC"
			class="js-select-submit-on-change"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field
			name="team"
			type="teams"
			label="COM_VOLUNTEERS_FIELD_TEAM"
			description="COM_VOLUNTEERS_FIELD_TEAM_DESC"
			multiple="true"
			layout="joomla.form.field.list-fancy-select"
			hint="COM_VOLUNTEERS_SELECT_TEAM"
			class="js-select-submit-on-change"
			/>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.title ASC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="team.title ASC">COM_VOLUNTEERS_SORT_TEAM_ASC</option>
			<option value="team.title DESC">COM_VOLUNTEERS_SORT_TEAM_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="COM_VOLUNTEERS_LIST_LIMIT"
			description="COM_VOLUNTEERS_LIST_LIMIT_DESC"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
