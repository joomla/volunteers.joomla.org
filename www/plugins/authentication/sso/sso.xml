<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="authentication" method="upgrade">
    <name>PLG_AUTHENTICATION_SSO</name>
    <creationDate>16 september 2026</creationDate>
    <author>RolandD Cyber Produksi</author>
    <authorEmail>contact@rolandd.com</authorEmail>
    <authorUrl>https://rolandd.com</authorUrl>
    <copyright>Copyright (C) 2017 - 2026 RolandD Cyber Produksi. All rights reserved.</copyright>
    <license>GNU/GPLv3 http://www.gnu.org/licenses/gpl-3.0.html</license>
    <version>2.3.1</version>
    <description>PLG_AUTHENTICATION_SSO_XML_DESCRIPTION</description>
    <namespace path="src">Rolandd\Plugin\Authentication\Sso</namespace>
    <files>
        <folder plugin="sso">services</folder>
        <folder>language</folder>
        <folder>src</folder>
    </files>

    <config>
        <fields name="params"
                addfieldprefix="Rolandd\Component\Sso\Administrator\Field">
            <fieldset name="basic">
                <field
                        name="authenticateArea"
                        type="list"
                        label="PLG_SYSTEM_SSO_FIELD_AUTHENTICATE_AREA_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_AUTHENTICATE_AREA_DESC"
                        default="site"
                >
                    <option value="*">JALL</option>
                    <option value="administrator">JADMINISTRATOR</option>
                    <option value="site">JSITE</option>
                </field>

                <field
                        name="profile"
                        type="Profile"
                        label="PLG_AUTHENTICATION_SSO_PROFILE_LABEL"
                        description="PLG_AUTHENTICATION_SSO_PROFILE_DESC"/>
            </fieldset>
        </fields>
    </config>
</extension>
