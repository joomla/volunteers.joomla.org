    <creationDate>January 2024</creationDate>
    <copyright>(C) 2005 - 2024 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@joomla.org</authorEmail>
    <authorUrl>www.joomla.org</authorUrl>
    <version>2.0.0</version>
    <description>PLG_SYSTEM_JOOMLAIDENTITYCLIENT_XML_DESCRIPTION</description>
    <namespace path="src">Joomla\Plugin\System\Joomlaidentityclient</namespace>
    <files>
        <folder plugin="joomlaidentityclient">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                        name="apikey"
                        type="text"
                        label="PLG_JOOMLAIDENTITYCLIENT_APIKEY_LABEL"
                        description="PLG_JOOMLAIDENTITYCLIENT_APIKEY_DESC"
                        class="input-xlarge"
                        required="true"
                />
            </fieldset>
