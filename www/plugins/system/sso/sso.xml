<?xml version="1.0" encoding="utf-8"?>
<extension version="3.8" type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_SSO</name>
    <creationDate>16 september 2026</creationDate>
    <author>RolandD Cyber Produksi</author>
    <authorEmail>contact@rolandd.com</authorEmail>
    <authorUrl>https://rolandd.com</authorUrl>
    <copyright>Copyright (C) 2017 - 2026 RolandD Cyber Produksi. All rights reserved.</copyright>
    <license>GNU/GPLv3 https://www.gnu.org/licenses/gpl-3.0.html</license>
    <version>2.3.1</version>
    <description>PLG_SYSTEM_SSO_XML_DESCRIPTION</description>
    <namespace path="src">Rolandd\Plugin\System\Sso</namespace>
    <files>
        <folder plugin="sso">services</folder>
        <folder>language</folder>
        <folder>src</folder>
    </files>

    <config>
        <fields name="params"
                addfieldprefix="Rolandd\Component\Sso\Administrator\Field">
            <fieldset name="basic">
                <field
                        name="profile"
                        type="Profile"
                        label="PLG_SYSTEM_SSO_PROFILE_LABEL"
                        description="PLG_SYSTEM_SSO_PROFILE_DESC"/>

                <field
                        name="preventLogin"
                        type="radio"
                        label="PLG_SYSTEM_SSO_FIELD_PREVENT_LOGIN_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_PREVENT_LOGIN_DESC"
                        class="btn-group btn-group-yesno"
                        default="0"
                        filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                        name="menuRedirect"
                        type="menuitem"
                        label="PLG_SYSTEM_SSO_FIELD_MENU_REDIRECT_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_MENU_REDIRECT_DESC"
                        showon="preventLogin:1"/>

                <field
                        name="autoLogin"
                        type="radio"
                        label="PLG_SYSTEM_SSO_FIELD_AUTO_LOGIN_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_AUTO_LOGIN_DESC"
                        class="btn-group btn-group-yesno"
                        default="0"
                        filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                        name="autoLoginArea"
                        type="list"
                        label="PLG_SYSTEM_SSO_FIELD_AUTO_LOGIN_AREA_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_AUTO_LOGIN_AREA_DESC"
                        default="site"
                        showon="autoLogin:1"
                >
                    <option value="*">JALL</option>
                    <option value="administrator">JADMINISTRATOR</option>
                    <option value="site">JSITE</option>
                </field>

                <field
                        name="escape"
                        type="text"
                        label="PLG_SYSTEM_SSO_FIELD_ESCAPE_LABEL"
                        description="PLG_SYSTEM_SSO_FIELD_ESCAPE_DESC"/>
            </fieldset>
        </fields>
    </config>
</extension>
